{
  "name": "aa-hl-question-bank",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:scraper": "node --test scraper/*.test.mjs",
    "scrape": "node scraper/scrape.mjs",
    "scrape:demo": "node scraper/scrape.mjs --demo",
    "db:start": "bash scripts/mysql.sh start",
    "db:stop": "bash scripts/mysql.sh stop",
    "db:status": "bash scripts/mysql.sh status",
    "db:create": "bash scripts/mysql.sh db",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "db:setup": "bash scripts/mysql.sh start && bash scripts/mysql.sh db && node scripts/migrate.mjs && node scripts/seed.mjs",
    "validate": "node scripts/validate-bank.mjs",
    "recover:diagrams": "node scraper/recover-diagrams.mjs",
    "repair:latex": "node scripts/repair-latex.mjs",
    "americanize": "node scripts/americanize.mjs",
    "build:static": "VITE_STATIC=1 vite build && cp public/_headers dist/_headers",
    "deploy": "npm run build:static && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.71.0",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
